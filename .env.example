FPLT_DATA_DIR=./data
# FPLT_ENTRY_ID=123456
# Bearer token from DevTools → my-team → x-api-authorization (value only).
# Expires about every 8 hours. Never commit a real token.
# FPLT_FPL_API_TOKEN=
# Legacy pl_profile cookie. The live API uses FPLT_FPL_API_TOKEN.
# FPLT_FPL_SESSION=
# FPLT_NTFY_URL=https://ntfy.sh/fplt-alerts
# Optional SMTP for recommendation email alerts — host/from/to required or no-op.
# FPLT_SMTP_HOST=smtp.example.com
# FPLT_SMTP_PORT=587
# FPLT_SMTP_USER=
# FPLT_SMTP_PASSWORD=
# FPLT_SMTP_FROM=fplt@example.com
# FPLT_SMTP_TO=you@example.com
# FPLT_SMTP_USE_TLS=true
